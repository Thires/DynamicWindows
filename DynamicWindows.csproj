<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net6.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <AssemblyName>DynamicWindows</AssemblyName>
    <RootNamespace>DynamicWindows</RootNamespace>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AllowUnsafeBlocks>false</AllowUnsafeBlocks>
    <Optimize Condition="'$(Configuration)'=='Release'">true</Optimize>
    <DebugType Condition="'$(Configuration)'=='Debug'">full</DebugType>
    <DebugType Condition="'$(Configuration)'=='Release'">pdbonly</DebugType>
    <Version>3.0.0</Version>
  </PropertyGroup>

  <!-- Genie plugin interface assembly — place Interfaces.dll in lib\ -->
  <ItemGroup>
    <Reference Include="Interfaces">
      <HintPath>lib\Interfaces.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Body silhouette images copied to output alongside the DLL -->
  <ItemGroup>
    <EmbeddedResource Include="Resources\body_image_ext.png" />
    <EmbeddedResource Include="Resources\body_image_int.png" />
  </ItemGroup>

</Project>
